# --- Core ---
NODE_ENV=development
PORT=4000
# MongoDB. Local dev: `npm run db:start` (replica set rs0, needed for transactions). Atlas: paste its mongodb+srv:// URI with the database name.
MONGODB_URI=mongodb://127.0.0.1:27017/luxwatch?replicaSet=rs0
WEB_ORIGIN=http://localhost:5173
# Long random string (>= 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# --- Razorpay (leave empty to keep online payments disabled) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# --- Email (leave SMTP_HOST empty to log emails to the console instead of sending) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
