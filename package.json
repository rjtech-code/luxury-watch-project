{
  "name": "time-luxe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "npm install --prefix server",
    "dev": "concurrently -n server,web -c yellow,cyan \"npm run dev --prefix server\" \"vite\"",
    "dev:web": "vite",
    "dev:server": "npm run dev --prefix server",
    "build": "vite build",
    "preview": "vite preview",
    "start": "npm start --prefix server",
    "test": "npm test --prefix server && vitest run",
    "db:start": "npm run db:start --prefix server",
    "db:stop": "npm run db:stop --prefix server",
    "db:seed": "npm run db:seed --prefix server",
    "db:photos": "npm run db:photos --prefix server",
    "db:demo": "npm run db:demo-enrich --prefix server",
    "admin:create": "npm run admin:create --prefix server"
  },
  "dependencies": {
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@tanstack/react-query": "^5.104.2",
    "clsx": "^2.1.1",
    "framer-motion": "^14.1.0",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "three": "^0.186.1",
    "zod": "^4.6.6",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "concurrently": "^9.0.0"
  }
}
