# Website (frontend) settings. Copy to .env and edit. Only variables starting with VITE_ are used,
# and every one of them ends up in the browser, so never put a secret here (secrets go in server/.env).

# Where `npm run dev` forwards /api and /uploads (the server). Change it if the server runs elsewhere.
VITE_API_PROXY=http://localhost:4000

# Production only: the server's full address, when the website and server are on different domains,
# e.g. https://api.example.com. Leave empty when both are served from the same domain.
VITE_API_URL=
